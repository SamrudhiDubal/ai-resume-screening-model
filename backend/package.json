{
  "name": "resume-screening-api",
  "version": "1.0.0",
  "description": "Express API that serves the AI resume screening and candidate matching model",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
